{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "lint": "eslint . && npm run lint:workflows",
    "lint:workflows": "node tools/workflows/cli.ts",
    "typecheck": "node tools/typecheck.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project tools",
    "test:integration": "vitest run --project redirect",
    "validate:tofu": "scripts/tofu-validate.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@typescript-eslint/rule-tester": "8.71.1",
    "@typescript-eslint/utils": "8.71.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
